    <choice id="default" title="JamfEA-Kit">
        <pkg-ref id="io.github.workprasanth9.jamfea-kit"/>
    </choice>
    <pkg-ref id="io.github.workprasanth9.jamfea-kit" version="@VERSION@">component.pkg</pkg-ref>
</installer-gui-script>
